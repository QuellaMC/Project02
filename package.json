{
  "name": "project02",
  "description": "The Live Character Framework's TypeScript workspace, beside the daemon under crates/: the page and the wire under packages/, and the suites that drive the binary under tests/.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "serve": "pnpm build:web && cargo run --locked -p project02 -- serve",
    "inspect": "cargo run --locked -p project02 -- inspect",
    "build:web": "pnpm --filter @project02/page build",
    "build": "pnpm build:web && cargo build --locked -p project02",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"packages/**/*.ts\" \"packages/**/*.tsx\" \"tests/**/*.ts\"",
    "format": "prettier --write \"packages/**/*.ts\" \"packages/**/*.tsx\" \"packages/**/*.css\" \"packages/**/*.html\" \"packages/**/*.json\" \"tests/**/*.ts\" \"tests/**/*.json\" \"crates/p02-phone/apps/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" \".dependency-cruiser.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig.base.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/**/*.tsx\" \"packages/**/*.css\" \"packages/**/*.html\" \"packages/**/*.json\" \"tests/**/*.ts\" \"tests/**/*.json\" \"crates/p02-phone/apps/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" \".dependency-cruiser.mjs\" \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig.base.json\" \".prettierrc.json\"",
    "typecheck": "pnpm -r typecheck",
    "arch:check": "node scripts/arch-check.mjs && node scripts/check-source-text.mjs",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:conformance": "pnpm build && pnpm --filter @project02/tests test:conformance",
    "test:browser": "pnpm build && pnpm --filter @project02/tests test:browser",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:coverage && pnpm test:browser",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked && git diff --exit-code -- packages/wire/src/contract/generated && cargo deny check && cargo about generate --workspace --locked --fail about.hbs -o THIRD-PARTY-NOTICES.txt && git diff --exit-code -- THIRD-PARTY-NOTICES.txt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.4.0",
    "prettier": "3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}

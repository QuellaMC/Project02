{
  "name": "project02",
  "description": "TypeScript rebuild baseline for the Live Character Framework.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "chat": "node src/cli/chat/main.ts",
    "runtime-config": "node src/cli/config/main.ts",
    "inspect": "node src/cli/inspect/main.ts",
    "relay": "node src/cli/relay/main.ts",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"vitest.config.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "arch:check": "node scripts/arch-check.mjs && node scripts/check-shared-consumers.mjs",
    "arch:baseline": "node scripts/arch-check.mjs --baseline",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "4.1.7",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}

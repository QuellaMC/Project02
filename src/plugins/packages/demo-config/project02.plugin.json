{
  "$schema": "../../../../schemas/project02.plugin.schema.json",
  "format": "project02.plugin.v1",
  "entry": "./index.ts",
  "manifest": {
    "id": "demo-config",
    "displayName": "Demo Config",
    "version": "1.0.0",
    "kind": "context_provider",
    "description": "Bundled demo plugin whose reply-style settings exist to exercise the runtime plugin config tools end to end.",
    "contractVersion": "mvp-008.runtime_plugin.v2",
    "compatibility": {
      "hostContractVersions": ["mvp-008.runtime_plugin.v2"]
    },
    "declaredPlugins": ["before_role_model_call"],
    "config": {
      "scope": "global_with_character_overrides",
      "fields": [
        {
          "name": "tone",
          "description": "Reply tone directive injected into every turn. Agent-adjustable; an approved change takes effect at once.",
          "required": false,
          "secret": false,
          "valueType": "string",
          "allowedValues": ["neutral", "warm", "formal", "playful", "pirate"],
          "agentMutable": true,
          "redactionLabels": [],
          "reloadRequired": false
        },
        {
          "name": "signoff",
          "description": "Exact signoff the assistant appends to every reply. Agent-adjustable; an approved change takes effect at once; unset means no signoff.",
          "required": false,
          "secret": false,
          "valueType": "string",
          "agentMutable": true,
          "redactionLabels": [],
          "reloadRequired": false
        },
        {
          "name": "operatorNote",
          "description": "Operator-owned note. Not agent-mutable: agent-initiated updates must be rejected.",
          "required": false,
          "secret": false,
          "valueType": "string",
          "agentMutable": false,
          "redactionLabels": []
        },
        {
          "name": "apiKey",
          "description": "Secret demo credential; config reads must show it redacted, never the raw value.",
          "required": false,
          "secret": true,
          "valueType": "string",
          "agentMutable": false,
          "redactionLabels": []
        }
      ]
    },
    "firstParty": true,
    "runtimePolicy": {
      "timeoutMs": 10000,
      "redactionLabels": [],
      "failureBehavior": {
        "beforeRoleModelCall": "degrade",
        "handleToolCall": "reject_tool_call",
        "health": "degrade"
      }
    },
    "activation": {
      "defaultEnabled": false,
      "reasons": ["bundled_demo_config"]
    },
    "requestedAccess": {
      "model_input": "write",
      "trusted_context": "write"
    }
  }
}

{
  "$schema": "../../../../schemas/project02.plugin.schema.json",
  "format": "project02.plugin.v1",
  "entry": "./index.ts",
  "manifest": {
    "id": "openclaw-compat",
    "displayName": "OpenClaw Context Engine Compat",
    "version": "1.0.0",
    "kind": "memory_provider",
    "description": "Mounts an OpenClaw context-engine plugin module as a memory provider: assemble becomes recall, ingest becomes turn capture. Pinned to interface v1; loading the configured module runs operator-trusted code.",
    "contractVersion": "mvp-008.runtime_plugin.v2",
    "compatibility": {
      "hostContractVersions": ["mvp-008.runtime_plugin.v2"]
    },
    "declaredPlugins": [
      "before_role_model_call",
      "after_turn_committed",
      "on_shutdown"
    ],
    "config": {
      "scope": "global_with_character_overrides",
      "fields": [
        {
          "name": "modulePath",
          "description": "Absolute path to the context-engine plugin module to mount. Importing it executes operator-trusted code.",
          "required": true,
          "secret": false,
          "valueType": "path",
          "agentMutable": false,
          "redactionLabels": [],
          "reloadRequired": true,
          "globalOnly": true
        },
        {
          "name": "engineId",
          "description": "Engine id to select when the module registers more than one context engine.",
          "required": false,
          "secret": false,
          "valueType": "string",
          "agentMutable": false,
          "redactionLabels": [],
          "reloadRequired": true,
          "globalOnly": true
        },
        {
          "name": "engineConfig",
          "description": "Non-secret settings object handed to the context-engine factory as its config argument. It is stored as written in the config file, so a credential belongs in engineApiKey instead.",
          "required": false,
          "secret": false,
          "valueType": "object",
          "agentMutable": false,
          "redactionLabels": [],
          "reloadRequired": true,
          "globalOnly": true
        },
        {
          "name": "engineApiKey",
          "description": "Credential the engine factory receives as config.apiKey. Held as a secret so it stays in the environment file rather than the config.",
          "required": false,
          "secret": true,
          "valueType": "string",
          "envVar": "OPENCLAW_ENGINE_API_KEY",
          "agentMutable": false,
          "redactionLabels": ["memory"],
          "reloadRequired": true
        }
      ]
    },
    "firstParty": false,
    "runtimePolicy": {
      "timeoutMs": 8000,
      "redactionLabels": ["memory"],
      "failureBehavior": {
        "beforeRoleModelCall": "degrade",
        "handleToolCall": "degrade",
        "health": "degrade"
      }
    },
    "activation": {
      "defaultEnabled": false,
      "reasons": ["memory_provider_package"],
      "globalOnly": true
    },
    "requestedAccess": {
      "turn_context": "read",
      "model_input": "write"
    }
  }
}

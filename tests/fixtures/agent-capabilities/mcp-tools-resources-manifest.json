{
  "id": "mcp.tools_resources.fixture",
  "displayName": "MCP tools and resources fixture",
  "version": "2025-06-18-fixture",
  "kind": "bridge_adapter",
  "description": "Normalized MCP tools/resources fixture for MVP-007 contract validation.",
  "contractVersion": "mvp-007.runtime_plugin.v1",
  "compatibility": {
    "hostContractVersions": ["mvp-007.runtime_plugin.v1"],
    "sourceSystem": "model-context-protocol",
    "sourceVersion": "2025-06-18",
    "externalContract": "mcp-tools-resources",
    "notes": ["tools map to provided tools, resources map to context source references"]
  },
  "declaredCapabilities": [
    "tool_provider",
    "handle_tool_call",
    "context_provider",
    "before_role_model_call",
    "health"
  ],
  "config": {
    "fields": [
      {
        "name": "server_id",
        "description": "Static fixture server id.",
        "required": true,
        "secret": false,
        "redactionLabels": []
      }
    ]
  },
  "localTrustLevel": "test_fixture",
  "runtimePolicy": {
    "requiredForTurn": false,
    "sideEffectLevel": "external_read",
    "confirmation": "not_required",
    "timeoutMs": 1000,
    "sourceReferencesRequired": true,
    "redactionLabels": [],
    "failureBehavior": {
      "beforeRoleModelCall": "degrade",
      "handleToolCall": "degrade",
      "afterTurnCommitted": "log_failure",
      "health": "degrade"
    }
  },
  "activation": {
    "defaultEnabled": false,
    "reasons": ["fixture_only"]
  }
}

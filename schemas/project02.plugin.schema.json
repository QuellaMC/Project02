{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project02.plugin.schema.json",
  "title": "Project02 runtime plugin package descriptor",
  "description": "Authoring schema for project02.plugin.json. Mirrors the runtime validator (src/plugins/api/manifest-validation.ts and package-descriptor.ts); intentionally stricter about unknown keys so typos surface while editing. tests/unit/plugin-package-schema.test.ts keeps this file honest against the code validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entry", "manifest"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "project02.plugin.v1"
    },
    "entry": {
      "type": "string",
      "pattern": "^\\./.+\\.(ts|js|mjs)$",
      "description": "Package-relative entry module exporting exactly one named createProject02Plugin factory."
    },
    "manifest": {
      "$ref": "#/definitions/manifest"
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "version",
        "kind",
        "description",
        "contractVersion",
        "compatibility",
        "declaredPlugins",
        "config",
        "firstParty",
        "runtimePolicy",
        "activation",
        "requestedAccess"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier",
          "description": "Stable plugin id; must equal the package folder name."
        },
        "displayName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "enum": [
            "first_party",
            "memory_provider",
            "tool_provider",
            "context_provider",
            "bridge_adapter"
          ]
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "contractVersion": {
          "const": "mvp-008.runtime_plugin.v2"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostContractVersions"],
          "properties": {
            "hostContractVersions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "mvp-008.runtime_plugin.v2"
              }
            }
          }
        },
        "declaredPlugins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tool_provider",
              "before_role_model_call",
              "handle_tool_call",
              "after_turn_committed",
              "on_session_end",
              "on_shutdown",
              "health",
              "plugin_discovery"
            ]
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "fields"],
          "properties": {
            "scope": {
              "enum": ["global_with_character_overrides", "character_only"],
              "description": "Whether enablement and settings may be authored globally with character overrides, or only in character/package config. Secret fields follow the same scope."
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/configField"
              }
            },
            "fingerprint": {
              "type": "string"
            }
          }
        },
        "firstParty": {
          "type": "boolean"
        },
        "runtimePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "redactionLabels", "failureBehavior"],
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "redactionLabels": {
              "$ref": "#/definitions/stringArray"
            },
            "failureBehavior": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beforeRoleModelCall", "handleToolCall", "health"],
              "properties": {
                "beforeRoleModelCall": {
                  "enum": ["reject_turn", "degrade"]
                },
                "handleToolCall": {
                  "enum": ["reject_tool_call", "degrade"]
                },
                "health": {
                  "enum": ["degrade", "reject_turn"]
                }
              }
            }
          }
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultEnabled", "reasons"],
          "properties": {
            "defaultEnabled": {
              "type": "boolean",
              "description": "Bundled packages with true activate without config; demo/test plugins should stay false and be enabled per store."
            },
            "reasons": {
              "$ref": "#/definitions/stringArray"
            }
          }
        },
        "requestedAccess": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_store": {
              "$ref": "#/definitions/accessLevel"
            },
            "character_file_store": {
              "$ref": "#/definitions/accessLevel"
            },
            "session_history": {
              "$ref": "#/definitions/accessLevel"
            },
            "plugin_database": {
              "$ref": "#/definitions/accessLevel"
            },
            "turn_context": {
              "$ref": "#/definitions/accessLevel"
            },
            "model_input": {
              "$ref": "#/definitions/accessLevel"
            },
            "curated_context": {
              "$ref": "#/definitions/accessLevel"
            }
          }
        }
      },
      "if": {
        "type": "object",
        "required": ["config"],
        "properties": {
          "config": {
            "type": "object",
            "required": ["scope"],
            "properties": {
              "scope": {
                "const": "character_only"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "description": "Character-only plugins cannot be enabled by the manifest default; enable them in a character package or character config.",
        "properties": {
          "activation": {
            "type": "object",
            "properties": {
              "defaultEnabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    "accessLevel": {
      "enum": ["none", "read", "write"]
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "required",
        "secret",
        "redactionLabels"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean",
          "description": "Secret values resolve from an env file first -- the manifest envVar or an authored {\"$env\"} reference -- and a plain string in config is accepted as a fallback. Reads are always redacted, and secret fields cannot be agentMutable."
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "secret",
            "path",
            "enum"
          ]
        },
        "defaultValueSummary": {
          "type": "string"
        },
        "envVar": {
          "type": "string"
        },
        "allowedValues": {
          "$ref": "#/definitions/stringArray"
        },
        "agentMutable": {
          "type": "boolean",
          "description": "true lets the model propose approval-gated updates via runtime.plugin.config.update."
        },
        "reloadRequired": {
          "type": "boolean",
          "description": "Whether a committed change to this field requires a runtime reload before taking effect."
        },
        "redactionLabels": {
          "$ref": "#/definitions/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "secret": {
                "const": true
              }
            },
            "required": ["secret"]
          },
          "then": {
            "not": {
              "properties": {
                "agentMutable": {
                  "const": true
                }
              },
              "required": ["agentMutable"]
            }
          }
        }
      ]
    }
  }
}

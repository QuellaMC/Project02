{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project02.plugin.schema.json",
  "title": "Project02 runtime plugin package descriptor",
  "description": "Authoring schema for project02.plugin.json. Mirrors the runtime validator (src/plugins/api/manifest-validation.ts and package-descriptor.ts); intentionally stricter about unknown keys so typos surface while editing. tests/unit/plugin-package-schema.test.ts keeps this file honest against the code validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entry", "manifest"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "project02.plugin.v1"
    },
    "entry": {
      "type": "string",
      "pattern": "^\\./.+\\.(ts|js|mjs)$",
      "description": "Package-relative entry module exporting exactly one named createProject02Plugin factory."
    },
    "manifest": {
      "$ref": "#/definitions/manifest"
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "version",
        "kind",
        "description",
        "contractVersion",
        "compatibility",
        "declaredPlugins",
        "config",
        "firstParty",
        "runtimePolicy",
        "activation",
        "requestedAccess"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier",
          "description": "Stable plugin id; must equal the package folder name."
        },
        "displayName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "enum": [
            "first_party",
            "memory_provider",
            "tool_provider",
            "context_provider",
            "bridge_adapter"
          ]
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "contractVersion": {
          "const": "mvp-008.runtime_plugin.v2"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostContractVersions"],
          "properties": {
            "hostContractVersions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "const": "mvp-008.runtime_plugin.v2"
              }
            }
          }
        },
        "declaredPlugins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tool_provider",
              "before_role_model_call",
              "handle_tool_call",
              "after_turn_committed",
              "on_session_end",
              "on_shutdown",
              "health",
              "plugin_discovery"
            ]
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "fields"],
          "properties": {
            "scope": {
              "$ref": "#/definitions/configScope",
              "description": "Where the plugin's switch and settings are set: in the home's settings with each character free to override them (global_with_character_overrides), in each character's settings only (character_only), or in the home's settings only (global_only). A field with no scope of its own takes this one."
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/configField"
              }
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "character_only"
                  }
                },
                "required": ["scope"]
              },
              "then": {
                "description": "A field cannot widen a character_only config.",
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "const": "character_only"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "global_only"
                  }
                },
                "required": ["scope"]
              },
              "then": {
                "description": "A field cannot widen a global_only config.",
                "properties": {
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "const": "global_only"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "firstParty": {
          "type": "boolean"
        },
        "runtimePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "redactionLabels", "failureBehavior"],
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "redactionLabels": {
              "$ref": "#/definitions/stringArray"
            },
            "failureBehavior": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beforeRoleModelCall", "handleToolCall", "health"],
              "properties": {
                "beforeRoleModelCall": {
                  "enum": ["reject_turn", "degrade"]
                },
                "handleToolCall": {
                  "enum": ["reject_tool_call", "degrade"]
                },
                "health": {
                  "enum": ["degrade", "reject_turn"]
                }
              }
            }
          }
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultEnabled", "reasons"],
          "properties": {
            "defaultEnabled": {
              "type": "boolean",
              "description": "Bundled packages with true activate without config; demo/test plugins should stay false and be enabled per store."
            },
            "reasons": {
              "$ref": "#/definitions/stringArray"
            }
          }
        },
        "requestedAccess": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_store": {
              "$ref": "#/definitions/accessLevel"
            },
            "character_file_store": {
              "$ref": "#/definitions/accessLevel"
            },
            "session_history": {
              "$ref": "#/definitions/accessLevel"
            },
            "plugin_database": {
              "$ref": "#/definitions/accessLevel"
            },
            "turn_context": {
              "$ref": "#/definitions/accessLevel"
            },
            "model_input": {
              "$ref": "#/definitions/accessLevel"
            },
            "trusted_context": {
              "$ref": "#/definitions/accessLevel"
            }
          }
        }
      },
      "if": {
        "type": "object",
        "required": ["config"],
        "properties": {
          "config": {
            "type": "object",
            "required": ["scope"],
            "properties": {
              "scope": {
                "const": "character_only"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "description": "Character-only plugins cannot be enabled by the manifest default; enable them in a character package or character config.",
        "properties": {
          "activation": {
            "type": "object",
            "properties": {
              "defaultEnabled": {
                "const": false
              }
            }
          }
        }
      }
    },
    "accessLevel": {
      "enum": ["none", "read", "write"]
    },
    "configScope": {
      "enum": [
        "global_with_character_overrides",
        "character_only",
        "global_only"
      ]
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "required",
        "secret",
        "redactionLabels"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/identifier"
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean",
          "description": "A credential, stored as a plain string with the scope's config at mode 0600. Reads are always redacted, and secret fields cannot be agentMutable."
        },
        "scope": {
          "$ref": "#/definitions/configScope",
          "description": "This field's own scope. In a global_with_character_overrides config it may narrow the field to each character's settings (character_only) or to the home's (global_only); in any other config it may only repeat the config's scope."
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "secret",
            "path",
            "enum"
          ]
        },
        "defaultValue": {
          "description": "What the field takes wherever no settings set it: a value of its valueType, and one of its allowedValues when it has them. A secret or a required field declares none."
        },
        "allowedValues": {
          "$ref": "#/definitions/stringArray"
        },
        "agentMutable": {
          "type": "boolean",
          "description": "true lets the model propose approval-gated updates via runtime.plugin.config.update."
        },
        "reloadRequired": {
          "type": "boolean",
          "description": "false lets an approved change take effect at once by rebuilding the plugin live; otherwise it waits for the next launch."
        },
        "redactionLabels": {
          "$ref": "#/definitions/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "secret": {
                "const": true
              }
            },
            "required": ["secret"]
          },
          "then": {
            "not": {
              "properties": {
                "agentMutable": {
                  "const": true
                }
              },
              "required": ["agentMutable"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "defaultValue": true
            },
            "required": ["defaultValue"]
          },
          "then": {
            "description": "A secret or a required field declares no default.",
            "properties": {
              "required": {
                "const": false
              },
              "secret": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project02.character.schema.json",
  "title": "Project02 character package descriptor",
  "description": "Authoring schema for project02.character.json. Mirrors the runtime validator (src/characters/api/package-descriptor.ts); intentionally strict about unknown keys so typos surface while editing. tests/unit/character-package-schema.test.ts keeps this file honest against the code validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "identity", "persona", "meta"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "project02.character.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "description": "Stable character id; must equal the package folder name and the identity recorded in its character-data marker."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(.*\\S)?$",
          "description": "Speaker name stamped on the character's messages. Renaming affects new sessions only; existing sessions keep their historical name."
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": {
        "system": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S",
            "description": "One persona section rendered into the system frame, in order. Persona only — runtime protocol text is not overridable."
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d{1,9}\\.\\d{1,9}\\.\\d{1,9}$",
          "description": "Semantic version of the character content, at most nine digits per component; recorded in turn evidence."
        }
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "description": "Plugins this character expects: required ids block activation when missing or disabled, recommended ids warn, and config supplies non-secret character defaults.",
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          }
        },
        "recommended": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9._-]{0,127}$": {
              "$ref": "#/definitions/packagePluginConfig"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "packagePluginConfig": {
      "type": "object",
      "properties": {
        "$env": false
      },
      "additionalProperties": {
        "$ref": "#/definitions/packageConfigValue"
      }
    },
    "packageConfigValue": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "items": {"$ref": "#/definitions/packageConfigValue"}
        },
        {
          "$ref": "#/definitions/packagePluginConfig"
        }
      ]
    }
  }
}

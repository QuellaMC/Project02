{
  "format": "project02.plugin.v2",
  "manifest": {
    "id": "world",
    "displayName": "World",
    "version": "1.0.0",
    "kind": "first_party",
    "description": "The world she lives in, the places in it and the things in them.",
    "contractVersion": "mvp-008.runtime_plugin.v2",
    "declaredPlugins": [
      "tool_provider",
      "before_role_model_call",
      "handle_tool_call"
    ],
    "config": {
      "scope": "character_only",
      "fields": []
    },
    "runtimePolicy": {
      "timeoutMs": 10000,
      "redactionLabels": [],
      "failureBehavior": {
        "beforeRoleModelCall": "degrade",
        "handleToolCall": "reject_tool_call"
      }
    },
    "activation": {
      "defaultEnabled": false,
      "reasons": ["built_in_world"]
    },
    "requestedAccess": {
      "character_file_store": "write",
      "model_input": "write",
      "trusted_context": "write"
    }
  }
}
